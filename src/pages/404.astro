---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found — Ridgeline AIOS" description="The page you're looking for isn't here.">
  <section class="bg-ridge" style="border-bottom:none;">
    <div class="container section-pad" style="text-align:center; padding-top:120px; padding-bottom:120px;">
      <p class="eyebrow">404</p>
      <h1 class="h1" style="margin-top:10px;">This trail doesn't lead anywhere.</h1>
      <p class="lead" style="margin:16px auto 0; max-width:480px;">The page you're looking for has moved or never existed. Let's get you back on the ridgeline.</p>
      <div style="margin-top:28px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn">Back to home →</a>
        <a href="/program" class="btn-ghost">See the program</a>
      </div>
    </div>
  </section>
</BaseLayout>
