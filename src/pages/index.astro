---
import BaseLayout from "../layouts/BaseLayout.astro";
import TerrainBridge from "../components/TerrainBridge.astro";

const components = [
  "OS Foundation & Governance",
  "Departmental Builds",
  "Training as Infrastructure",
  "Strategic Advisory",
  "Impact Reporting",
];

const benefits = [
  { h: "Global talent, fully empowered", b: "Distributed teams operating at the level of your best people." },
  { h: "Sharper strategy & hiring", b: "Better decisions, made faster, with the full context of your business." },
  { h: "Marketing & sales that compound", b: "Not just efficiency — real revenue generation." },
  { h: "Professional fees, collapsed", b: "Much of what you pay lawyers, consultants, and fractional CFOs, the system answers." },
];

const fit = [
  { h: "$5M–$100M, founder-led", b: "Complex enough that scattered tools won't cut it." },
  { h: "Committed, not curious", b: "Ready for an organization-wide build — not another pilot." },
  { h: "All-in on Claude", b: "Ridgeline is built exclusively on Claude. That coherence is the point." },
];
---

<BaseLayout
  title="Ridgeline AIOS — One AI Operating System, Installed Across Your Company"
  description="Ridgeline installs AI into every department of your business — governed, owned by you, built on Claude. A program of Headlands Ops."
>
  <!-- 1. HERO -->
  <section class="bg-dark on-dark hero">
    <TerrainBridge toColor="#F1EFE9" />
    <div class="container section-pad" style="position:relative; z-index:1; padding-top:88px; padding-bottom:80px;">
      <p class="eyebrow">A Headlands Ops Program</p>
      <h1 class="h1">One AI operating system,<br/>installed across your company.</h1>
      <p class="lead" style="margin-top:18px;">Ridgeline installs AI into every department of your business — governed, owned by you, and operating at the level you do. Done with you, built on Claude.</p>
      <div class="cta-row" style="margin-top:30px;">
        <a href="/apply" class="btn">Apply for the Program →</a>
        <a href="#how" class="nav-inline">How it works ↓</a>
      </div>
    </div>
  </section>

  <!-- 2. FOUNDER IN MOTION -->
  <section class="bg-paper">
    <div class="container section-pad">
      <p class="eyebrow">You Already Know This</p>
      <h2 class="h2" style="max-width:780px;">You know you should be doing this.<br/>You may already be good at it yourself.<br/><span class="italic" style="color:var(--sage);">So why hasn't it reached your company?</span></h2>
      <p class="body" style="margin-top:18px;">You've watched the demos. Maybe you've gotten genuinely sharp with Claude or ChatGPT on your own. You know your competitors are racing toward this — and you know, roughly, what it's worth. Faster teams. Lower costs. You're not behind because you don't understand AI.</p>
      <p class="body" style="margin-top:12px;">You're stuck because no one has shown you what it actually means to <em style="color:var(--ink); font-style:normal;">install</em> it — across the whole company, not just in your own browser tabs.</p>
    </div>
  </section>

  <!-- 3. DIAGNOSIS -> RESOLUTION -->
  <section class="bg-dune">
    <div class="container section-pad">
      <p class="eyebrow">The Real Problem</p>
      <h2 class="h2" style="max-width:720px;">The problem was never you.<br/>It's how the whole industry talks about AI.</h2>
      <p class="body" style="margin-top:16px;">Look at who's selling AI to the small-and-mid market. Trainers who teach your team prompts. Point-solution vendors with thirty tools in a thirty-minute pitch. Enterprise firms like Deloitte who only work above your weight class. Every one of them sells a piece. None of them sells the whole.</p>
      <p class="body" style="margin-top:12px;">So you're left with a fog: <span class="italic" style="font-size:18px;">I know I need AI — but what does it even mean to install it across my company?</span> Tools are part of it. Training is part of it. But a pile of parts isn't a system.</p>

      <div class="shift-card">
        <p class="eyebrow" style="color:var(--gold);">The Shift</p>
        <p class="shift-lead">It gets clear the moment you see your company as an operating system — your AI architecture and your departments, designed to run together.</p>
        <p class="body" style="font-size:14px; margin:0;">Not a tool you adopt. Not a course your team takes. A system that's installed, governed, and owned — the way every other core function of your business already works.</p>
      </div>

      <div class="vs-grid">
        <div class="vs-cell"><p class="mono-meta">Point Tools &amp; Training</p><p class="body" style="font-size:13px; margin-top:8px;">Scattered. Don't share context. Get adopted by a few, abandoned by most. The capability lives in individuals.</p></div>
        <div class="vs-cell vs-accent"><p class="mono-meta" style="color:var(--tide);">An AI Operating System</p><p class="body" style="font-size:13px; margin-top:8px;">Architected across departments. Shared context and governance. Owned by the company. The capability lives in the business.</p></div>
      </div>
    </div>
  </section>

  <!-- 4. BENEFITS -->
  <section class="bg-dark on-dark">
    <div class="container section-pad">
      <p class="eyebrow">The Upside You Haven't Counted</p>
      <h2 class="h2" style="max-width:720px;">You know it saves time and money.<br/>That's the part everyone can see.</h2>
      <p class="body" style="margin-top:14px;">The bigger returns are the ones most founders never put a number to — because nobody's framed them as a system before:</p>
      <div class="benefit-grid">
        {benefits.map((x) => (
          <div class="card"><h3 class="h3" style="font-size:18px;">{x.h}</h3><p class="body" style="font-size:13px; margin-top:5px;">{x.b}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. ENGINE TEASER -->
  <section class="bg-paper" id="how">
    <div class="container section-pad">
      <div class="engine-grid">
        <div>
          <p class="eyebrow">The Program</p>
          <h2 class="h2">A real system, installed department by department.</h2>
          <p class="body">Ridgeline isn't advice or a workshop. It's a structured program that builds your AI operating system across the company — foundation and governance first, then department by department, with training and oversight built in. You own it when it's done.</p>
          <div style="margin-top:20px;"><a href="/program" class="btn-ghost">Learn about the program →</a></div>
        </div>
        <div>
          <p class="mono-meta" style="color:var(--tide); margin-bottom:12px;">What's inside</p>
          <div class="engine-list">
            {components.map((c) => <div class="engine-item">{c}</div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. WHO IT'S FOR -->
  <section class="bg-dune">
    <div class="container section-pad">
      <p class="eyebrow">Is This You</p>
      <h2 class="h2">Built for founders ready to install.</h2>
      <div class="fit-grid">
        {fit.map((x) => (
          <div class="card"><h3 class="h3" style="font-size:17px;">{x.h}</h3><p class="body" style="font-size:13px; margin-top:6px;">{x.b}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. CLOSE -->
  <section class="bg-tide close" style="border-bottom:none;">
    <div class="container section-pad" style="text-align:center;">
      <h2 class="h2" style="color:#fff;">Ready to install AI for real?</h2>
      <p class="lead" style="color:#dde4e7; margin:16px auto 0; max-width:600px;">Ridgeline is application-gated and runs at limited capacity. The first conversation is a diagnostic — not a sales pitch.</p>
      <div style="margin-top:28px;"><a href="/apply" class="btn">Apply for the Program →</a></div>
      <p class="body" style="color:#cdd6da; margin:20px auto 0; font-size:13px;">Not ready for the full build? There's a <a href="/apply" style="color:#fff;">founder-level entry point</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; }
  .cta-row { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .nav-inline { font-size: 13px; color: var(--tide); text-decoration: none; }

  .shift-card { margin-top: 26px; padding: 24px; background: var(--card-lt); border: 1px solid var(--line-lt); border-radius: var(--radius-lg); max-width: 760px; }
  .shift-lead { font-family: var(--fd); font-size: 24px; line-height: 1.25; margin: 10px 0; color: var(--ink); }

  .vs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line-lt); border-radius: var(--radius-lg); overflow: hidden; margin-top: 22px; max-width: 820px; }
  .vs-cell { background: var(--card-lt); padding: 20px; }
  .vs-accent { border-left: 2px solid var(--tide); }

  .benefit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 22px; max-width: 760px; }
  .engine-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: center; }
  .engine-list { display: flex; flex-direction: column; }
  .engine-item { font-family: var(--fd); font-size: 18px; color: var(--ink-soft); padding: 11px 0; border-bottom: 1px solid var(--line-lt); }
  .engine-item:first-child { border-top: 1px solid var(--line-lt); }
  .fit-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-top: 22px; }

  @media (max-width: 768px) {
    .vs-grid, .benefit-grid, .engine-grid, .fit-grid { grid-template-columns: 1fr; }
  }
</style>
