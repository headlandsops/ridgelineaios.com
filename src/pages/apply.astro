---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  { n: "1", b: "We review every application personally — usually within two business days.", gold: true },
  { n: "2", b: "If it looks like a fit, we schedule a diagnostic call — a real conversation about your company, not a sales pitch." },
  { n: "3", b: "If it's right for both of us, we scope the engagement together." },
];
---

<BaseLayout
  title="Apply — Ridgeline AIOS"
  description="Ridgeline is application-gated and runs at limited capacity. Start with a conversation about whether we're the right fit for each other."
>
  <section class="bg-paper apply-wrap" style="border-bottom:none;">
    <div class="apply-grid">
      <!-- LEFT — framing -->
      <div class="apply-left">
        <p class="eyebrow">Apply</p>
        <h1 class="h1" style="font-size:clamp(30px,4vw,38px);">Start with a<br/><span class="italic" style="color:var(--sage);">conversation.</span></h1>
        <p class="body" style="margin-top:14px;">Ridgeline is application-gated and runs at limited capacity. This isn't a checkout — it's the start of a conversation about whether we're the right fit for each other.</p>

        <div class="steps-label mono-meta">What happens next</div>
        <div class="steps">
          {steps.map((s) => (
            <div class="step">
              <span class="step-num" style={`color:${s.gold ? "var(--gold)" : "var(--tide)"};`}>{s.n}</span>
              <p class="body" style="font-size:13.5px; margin:0;">{s.b}</p>
            </div>
          ))}
        </div>

        <div class="offramp">
          <p class="body" style="font-size:13px; font-style:italic; color:var(--slate);">Not ready for the full program? Mention it below — there's a founder-level entry point for getting capable before an org-wide build.</p>
        </div>
      </div>

      <!-- RIGHT — HubSpot form -->
      <div class="apply-right">
        <div class="ridgeline-apply-form">
          <!-- HubSpot embedded form — Ridgeline application.
               Portal 245879662 · region na2 · form 114a99f4-3c5c-4bb5-b2d4-b76aa254943f
               Form FIELDS (revenue range, team size, AI stage, what-to-solve,
               source, founder-entry interest) and pipeline ROUTING are configured
               in HubSpot, not here. Routes to the dedicated Ridgeline pipeline,
               separate from Headlands Ops. -->
          <div class="hs-form-frame" data-region="na2" data-form-id="114a99f4-3c5c-4bb5-b2d4-b76aa254943f" data-portal-id="245879662"></div>
        </div>
        <p class="mono-meta" style="margin-top:14px; color:var(--slate);">We review every application personally.</p>
      </div>
    </div>
  </section>

  <!-- HubSpot embed script -->
  <script src="https://js-na2.hsforms.net/forms/embed/245879662.js" defer></script>
</BaseLayout>

<style>
  .apply-wrap { padding: 0; }
  .apply-grid { display: grid; grid-template-columns: 360px 1fr; max-width: var(--container); margin: 0 auto; }
  .apply-left { padding: 60px 40px 60px var(--container-pad); border-right: 1px solid var(--line-lt); }
  .apply-right { padding: 56px 48px; background: var(--dune); }

  .steps-label { margin: 26px 0 14px; padding-top: 18px; border-top: 1px solid var(--line-lt); }
  .steps { display: flex; flex-direction: column; gap: 14px; }
  .step { display: flex; gap: 12px; }
  .step-num { font-family: var(--fd); font-size: 18px; }
  .offramp { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line-lt); }

  /* ---- HubSpot form — full dark/light-register overrides ----
     HubSpot injects its own markup + stylesheet and wins specificity on the
     button and selects, so most rules need !important. This is a MULTI-STEP
     form (note the Next button + progress bar), so we style .hs-button broadly
     plus the step navigation and progress bar. */

  /* fields + labels */
  .ridgeline-apply-form :global(.hs-form-field) { margin-bottom: 18px; }
  .ridgeline-apply-form :global(.hs-form-field label) {
    font-family: var(--fm) !important; font-size: 10px !important; letter-spacing: 1.5px !important;
    text-transform: uppercase !important; color: var(--ink) !important;
    margin-bottom: 7px !important; display: block; font-weight: 500 !important;
  }
  .ridgeline-apply-form :global(.hs-input),
  .ridgeline-apply-form :global(input.hs-input),
  .ridgeline-apply-form :global(select.hs-input),
  .ridgeline-apply-form :global(textarea.hs-input) {
    width: 100% !important; background: #ffffff !important;
    border: 1px solid var(--line-lt) !important; border-radius: 7px !important;
    padding: 11px 13px !important; color: var(--ink) !important;
    font-family: var(--fb) !important; font-size: 14px !important;
    box-shadow: none !important; height: auto !important;
  }
  .ridgeline-apply-form :global(.hs-input:focus),
  .ridgeline-apply-form :global(select.hs-input:focus) {
    border-color: var(--tide) !important; outline: none !important;
    box-shadow: 0 0 0 2px rgba(78,113,129,0.15) !important;
  }
  .ridgeline-apply-form :global(.hs-input::placeholder) { color: var(--slate) !important; }
  .ridgeline-apply-form :global(textarea.hs-input) { min-height: 90px !important; }

  /* select dropdowns — HubSpot styles these heavily; force consistent look */
  .ridgeline-apply-form :global(select.hs-input) {
    appearance: none !important; -webkit-appearance: none !important;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%235A6068' stroke-width='1.5' fill='none' stroke-linecap='round'/></svg>") !important;
    background-repeat: no-repeat !important; background-position: right 14px center !important;
    padding-right: 36px !important;
  }

  /* phone / intl-tel field (country flag + code) */
  .ridgeline-apply-form :global(.hs-input.hs-fieldtype-intl-phone),
  .ridgeline-apply-form :global(.hs_phone .input) { display: flex !important; gap: 8px !important; }
  .ridgeline-apply-form :global(.hs-fieldtype-intl-phone select) {
    width: auto !important; min-width: 84px !important; flex: 0 0 auto !important;
  }

  /* BUTTON — primary gold. Covers submit + multi-step Next. */
  .ridgeline-apply-form :global(.hs-button),
  .ridgeline-apply-form :global(input[type="submit"]),
  .ridgeline-apply-form :global(.actions input),
  .ridgeline-apply-form :global(.hs-button.primary) {
    background: var(--gold) !important; background-color: var(--gold) !important;
    color: var(--ridge) !important;
    font-family: var(--fm) !important; font-size: 11px !important;
    letter-spacing: 1px !important; text-transform: uppercase !important;
    font-weight: 500 !important; border: none !important; border-radius: 6px !important;
    padding: 13px 24px !important; cursor: pointer !important; margin-top: 6px !important;
    box-shadow: none !important; opacity: 1 !important; text-shadow: none !important;
    width: auto !important;
  }
  .ridgeline-apply-form :global(.hs-button:hover),
  .ridgeline-apply-form :global(.actions input:hover) { opacity: 0.9 !important; }
  .ridgeline-apply-form :global(.actions) { text-align: left !important; margin-top: 4px; }

  /* multi-step progress bar — tint to brand */
  .ridgeline-apply-form :global(.hs-progress-bar),
  .ridgeline-apply-form :global([class*="progress"] > div) { background: var(--tide) !important; }

  /* errors + required marker */
  .ridgeline-apply-form :global(.hs-error-msgs label) { color: #B5524A !important; font-family: var(--fb) !important; text-transform: none !important; letter-spacing: 0 !important; font-size: 12px !important; font-weight: 400 !important; }
  .ridgeline-apply-form :global(.hs-form-required) { color: var(--tide) !important; }

  @media (max-width: 768px) {
    .apply-grid { grid-template-columns: 1fr; }
    .apply-left { border-right: none; border-bottom: 1px solid var(--line-lt); padding: 48px 24px; }
    .apply-right { padding: 40px 24px; }
  }
</style>
