---
/*
  TerrainBand — the sanctioned decorative texture for the imageless system.
  The layered-hills motif from the logo, used at low opacity as a section
  accent (sits at the bottom of a section, behind content). Derived from the
  brand mark, so it is on-brand texture rather than borrowed imagery.

  Props:
    opacity: overall opacity of the band (default 0.06 — very subtle)
    position: "bottom" (default) | "top"
*/
const { opacity = 0.06, position = "bottom" } = Astro.props;
const flip = position === "top" ? "transform: scaleY(-1); top:0;" : "bottom:0;";
---
<div class="terrain-band" style={`opacity:${opacity}; ${flip}`} aria-hidden="true">
  <svg viewBox="0 0 1440 200" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 110 Q160 70,320 84 Q480 98,620 64 Q760 30,920 48 Q1080 66,1220 44 Q1340 28,1440 44 L1440 200 L0 200 Z" fill="#8B9E82"/>
    <path d="M0 140 Q200 104,360 116 Q520 128,660 96 Q800 66,980 84 Q1140 100,1280 80 Q1380 66,1440 88 L1440 200 L0 200 Z" fill="#4A7268"/>
  </svg>
</div>

<style>
  .terrain-band { position: absolute; left: 0; right: 0; height: 200px; pointer-events: none; z-index: 0; }
  .terrain-band svg { width: 100%; height: 100%; display: block; }
</style>
