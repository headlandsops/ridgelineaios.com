---
/*
  TerrainBridge — sits at the bottom of a dark section (hero or accent band) and
  resolves the dark INTO the light body via the layered-hills motif. The topmost
  path is filled with the body's paper color so the dark dissolves through the
  ridge rather than ending at a hard horizontal seam.

  Use inside a position:relative dark section, as the last child before content
  wrappers, or absolutely positioned at the bottom.

  Props:
    toColor: the color the section resolves INTO (default --paper). Pass --dune
             if the next section is the dune shade.
*/
const { toColor = "#F1EFE9" } = Astro.props;
---
<div class="terrain-bridge" aria-hidden="true">
  <svg viewBox="0 0 1440 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 120 Q160 80,320 94 Q480 108,620 74 Q760 40,920 58 Q1080 76,1220 54 Q1340 38,1440 54 L1440 220 L0 220 Z" fill="#8B9E82" opacity="0.16"/>
    <path d="M0 150 Q200 114,360 126 Q520 138,660 106 Q800 76,980 94 Q1140 110,1280 90 Q1380 76,1440 98 L1440 220 L0 220 Z" fill="#4A7268" opacity="0.22"/>
    <path d="M0 180 Q240 156,480 166 Q720 176,960 160 Q1200 144,1440 166 L1440 220 L0 220 Z" fill={toColor}/>
  </svg>
</div>

<style>
  .terrain-bridge { position: absolute; bottom: -1px; left: 0; right: 0; height: 120px; pointer-events: none; z-index: 0; }
  .terrain-bridge svg { width: 100%; height: 100%; display: block; }
</style>
